<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="operations_detail_bom_form_view" model="ir.ui.view">
        <field name="name">operations.detail.bom.form.view</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="get_operations_recursion" type="object" class="oe_stat_button" icon="fa-tree" groups="mrp.group_mrp_routings">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Sub-Operations<br/>Recursion</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
