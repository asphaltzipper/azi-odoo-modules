<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_config_mod" model="ir.ui.view">
        <field name="name">sale.order.form.config</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="product_configurator_sale.sale_order_form_config"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree//field[@name='config_session_id']"
                position="attributes"
            >
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

</odoo>
