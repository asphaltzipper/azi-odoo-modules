<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_openai_connector_form" model="ir.ui.view">
        <field name="name">view.openai.connector.form</field>
        <field name="model">openai.connector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_connect" type="object" string="Connect" states="draft" class="btn btn-primary"/>
                    <button name="action_to_draft" type="object" string="Reset to Draft" states="failed" class="btn"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ai_model" attrs="{'readonly': [('state', '!=', 'draft')]}" required="1"/>
                            <field name="api_key_name" attrs="{'readonly': [('state', '!=', 'draft')]}" required="1"/>

                        </group>
                        <group>
                            <field name="is_openai_model" attrs="{'readonly': [('state', '!=', 'draft')]}" />
                            <field name="base_url" attrs="{'invisible': [('is_openai_model', '=', True)],
                                                           'required': [('is_openai_model', '=', False)]}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="System Prompt">
                            <field name="system_prompt" attrs="{'readonly': [('state', '!=', 'draft')]}" required="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_openai_connector_tree" model="ir.ui.view">
        <field name="name">view.openai.connector.tree</field>
        <field name="model">openai.connector</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ai_model"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_openai_connector" model="ir.actions.act_window">
        <field name="name">OpenAI Connector</field>
        <field name="res_model">openai.connector</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_openai" name="OpenAI" parent="base.menu_administration" sequence="2"/>
    <menuitem id="menu_openai_connector" parent="menu_openai" action="action_openai_connector"/>
</odoo>
