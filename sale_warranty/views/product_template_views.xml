<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_warranty_product" model="ir.ui.view">
        <field name="name">product.template.warranty.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="upsell" position="attributes">
                <attribute name="invisible">0</attribute>
            </group>
            <group name="upsell" position="inside">
                <field name="is_warranty"/>
                <field name="warranty_units" attrs="{'invisible': [('is_warranty', '=', False)]}"/>
                <field name="warranty_duration" attrs="{'invisible': [('is_warranty', '=', False)]}"/>
            </group>
        </field>
    </record>

</odoo>
