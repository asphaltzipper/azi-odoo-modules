<?xml version="1.0"?>
<odoo>

    <!-- add credit_app_date field -->
    <record id="res_partner_view_credit_app" model="ir.ui.view">
        <field name="name">res.partner.view.credit_app</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <page name="sales_purchases" position="after">
                <page name="credit" string="Credit">
                    <group>
                        <field name="credit_app_date"/>
                        <field name="credit_warn"/>
                        <field name="credit_warn_msg"/>
                    </group>
                    <field name="credit_app_ids" nolabel="1" context="{'default_partner_id': active_id}">
                        <tree>
                            <field name="partner_id"/>
                            <field name="requested_date"/>
                            <field name="order_id"/>
                            <field name="received_date"/>
                            <button type="object" name="action_open_credit_app" title="Go" icon="fa-arrow-right" help="Go to this credit app"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
