<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <div class="o_action" t-name="serial_crm.CombinedBomReport" owl="1">
        <ControlPanel display="controlPanelDisplay">
            <t t-set-slot="control-panel-bottom-left-buttons">
                <div class="o_cp_buttons">
                    <div class="o_list_buttons"/>
                </div>
            </t>
            <t t-set-slot="control-panel-top-right">
                <form class="row gx-0">
                    <div class="col-lg-8 row">
                        <div class="col-lg-11 row gx-1 mb-2">


                        </div>
                    </div>
                </form>
            </t>

            <t t-set-slot="control-panel-bottom-right">
                <div class="o_search_options">

                </div>
            </t>
        </ControlPanel>
        <div class="o_content overflow-auto h-100">
            <div class="row">
                <div class="col-lg-12">
                    <div class="mt16">
                        <h2>BOM Changes</h2>
                        <table class="table table-bordered" width="100%">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Serial</th>
                                    <th>Change Type</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.bomChanges">
                                <t t-foreach="state.bomChanges" t-as="bom_change" t-key="bom_change[0]">
                                    <tr class="o_bom_change_line" t-att-data-id="bom_change[7]"
                                        t-att-data-child_component_id="bom_change[2]">
                                    <td>
                                        <t t-set="has_bom" t-value="bom_change[5] and bom_change[3] == 'add'"/>
                                        <t t-set="space_td"
                                           t-value="'margin-left: '+ bom_change[9] * 20 + 'px;'"/>
                                        <span t-att-style="space_td"/>
                                        <a href="#" t-att-data-res-id="bom_change[0]"
                                           t-att-data-model="'product.product'" t-on-click.prevent="goToAction"
                                        >
                                            <t t-esc="bom_change[8]"/>
                                        </a>
                                    </td>
                                        <td>
                                        <t t-esc="bom_change[1]"/>
                                    </td>
                                        <td>
                                        <a href="#" t-on-click.prevent="goToAction"
                                           t-att-data-model="'stock.lot'"
                                           t-att-data-res-id="bom_change[2]" t-esc="bom_change[6]"/>
                                    </td>
                                        <td>
                                        <t t-esc="bom_change[3]"/>
                                    </td>
                                        <td>
                                        <t t-esc="bom_change[4]"/>
                                    </td>
                                </tr>
                                </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="5">
                                            <h4 class="text-center">No data available.</h4>
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>
                        <br/>
                        <h2>Repair Order Parts</h2>
                        <table class="table table-bordered" width="100%">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Serial</th>
                                    <th>Change Type</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.repairOrders">
                                <t t-foreach="state.repairOrders" t-as="order" t-key="order[1]">
                                    <tr t-att-data-id="'r_'+order[1]">
                                        <t t-if="order[0]">
                                            <td>
                                                <t t-set="space_td" t-value="'margin-left: '+ order[8] * 20 + 'px;'"/>
                                                <span t-att-style="space_td"/>
                                                <a href="#" t-att-data-res-id="order[1]"
                                                   t-att-data-model="order[7]"
                                                   t-on-click.prevent="goToAction">
                                                    <t t-esc="order[3]"/>
                                                </a>

                                                <t t-if="order[5] and order[6] == 'phantom'">
                                                    <span class="fa fa-dropbox" title="This is a BoM of type Kit!" role="img"
                                                          aria-label="This is a BoM of type Kit!"/>
                                                </t>
                                            </td>
                                            <td>
                                                <span>
                                                    <a href="#" t-att-data-res-id="order[2]"
                                                       t-att-data-model="'product.product'"
                                                       class="o_combined_bom_action">
                                                        <t t-esc="order[3]"/>
                                                    </a>
                                                </span>

                                            </td>
                                            <td>
                                                <t t-esc="order[4]"/>
                                            </td>
                                            <td/>
                                            <td/>
                                            <td/>
                                        </t>
                                        <t t-else="">
                                            <td>
                                                <t t-set="space_td"
                                                       t-value="'margin-left: '+ order[14] * 20 + 'px;'"/>
                                                <span t-att-style="space_td"/>
                                                <a href="#" t-att-data-res-id="order[8]"
                                                   t-att-data-model="order[13]"
                                                   t-on-click.prevent="goToAction">
                                                    <t t-esc="order[9]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="#" t-att-data-res-id="order[5]"
                                                   t-att-data-model="'product.product'"
                                                   t-on-click.prevent="goToAction">
                                                    <t t-esc="order[3]"/>
                                                </a>
                                            </td>
                                            <td><t t-esc="order[6]"/></td>
                                            <td>
                                                <a t-if="order[7]" href="#" t-att-data-res-id="order[2]"
                                                   t-att-data-model="'stock.lot'"
                                                   t-on-click.prevent="goToAction">
                                                    <t t-esc="order[7]"/>
                                                </a>
                                            </td>
                                            <td><t t-esc="order[4]"/></td>
                                            <td><t t-esc="order[11]" t-options="{'widget': 'date'}"/></td>
                                            <!--                                                <t t-call="serial_crm.report_repair_order_line"/>-->
                                        </t>
                                    </tr>
                                </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="6">
                                            <h4 class="text-center">No data available.</h4>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <br/>
                        <br/>
                        <h2>Original MO BOM</h2>
                        <table width="100%" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Serial</th>
                                    <th>MO</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.mos">
                                    <t t-foreach="state.mos" t-as="mo" t-key="mo[0]">
                                        <tr class="o_mrp_order_line" t-att-data-id="mo[0]">
                                            <td>
                                                <t t-set="space_td"
                                                   t-value="'margin-left: '+ mo[8] * 20 + 'px;'"/>
                                                <span t-att-style="space_td"/>
                                                <a href="#" t-att-data-res-id="mo[2]"
                                                   t-att-data-model="'product.product'" t-on-click.prevent="goToAction">
                                                    <t t-esc="mo[3]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <t t-esc="mo[4]"/>
                                            </td>
                                            <td>
                                                <t t-esc="mo[5]"/>
                                            </td>
                                            <td>
                                                <a href="#" t-att-data-res-id="mo[6]"
                                                   t-att-data-model="'mrp.production'" t-on-click.prevent="goToAction">
                                                    <t t-esc="mo[7]"/>
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="4">
                                            <h4 class="text-center">No data available.</h4>
                                        </td>

                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <br/>
                    </div>
                </div>
            </div>
        </div>
    </div>

</templates>
