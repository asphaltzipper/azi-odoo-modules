<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mqtt_client_form" model="ir.ui.view">
        <field name="name">view.mqtt.client.form</field>
        <field name="model">mqtt.client</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_sims" string="Add to Hologram" type="object" attrs="{'invisible': [('state', '!=', 'unallocated')]}" class="oe_highlight"/>
                    <button name="action_activate_sim" string="Activate" type="object" attrs="{'invisible': [('state', 'not in', ['unallocated', 'pause'])]}" class="oe_highlight"/>
                    <button name="action_deactivate_sim" string="Deactivate" type="object" attrs="{'invisible': [('state', '!=', 'live')]}"/>
                    <button name="action_fetch_status" string="Sync Status" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="unallocated,live,pause,dead"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_review_incoming_history" type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                context="{'signal_id': id}">
                            <div class="o_stat_info">
                                <field name="incoming_message_count" class="o_stat_value"/>
                                <span class="o_stat_text">In-Msgs</span>
                            </div>
                        </button>
                        <button name="action_review_outgoing_history" type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                context="{'signal_id': id}">
                            <div class="o_stat_info">
                                <field name="outgoing_message_count" class="o_stat_value"/>
                                <span class="o_stat_text">Out-Megs</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="current_lot_id"/>
                            <field name="hologram_name"/>
                            <field name="hologram_device_id"/>
                        </group>
                        <group>
                            <field name="hologram_plan"/>
                            <field name="hologram_link_id"/>
                            <field name="hologram_sync_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Serial/Lot" context="{'default_client_id': active_id}">
                            <field name="serial_ids">
                                <tree create="1" edit="1" editable="top">
                                    <field name="sequence" widget="handle"/>
                                    <field name="client_id" invisible="1"/>
                                    <field name="lot_id"/>
                                    <field name="install_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Outbound Messages">
                            <field name="history_ids" readonly="1" domain="[('client_id', '=', id)]">
                                <tree>
                                    <field name="topic"/>
                                    <field name="qos"/>
                                    <field name="timestamp"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_mqtt_client_tree" model="ir.ui.view">
        <field name="name">view.mqtt.client.tree</field>
        <field name="model">mqtt.client</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="hologram_name"/>
                <field name="state"/>
                <field name="current_lot_id"/>
            </tree>
        </field>
    </record>

    <record id="mqtt_client_action" model="ir.actions.act_window">
        <field name="name">Client</field>
        <field name="res_model">mqtt.client</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="mqtt_client_menu"
        parent="mqtt_integration.menu_mqtt_configuration"
        action="mqtt_client_action"
        sequence="3"/>

</odoo>
