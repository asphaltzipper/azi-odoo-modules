<?xml version="1.0" ?>
<odoo>
    <record id="view_mqtt_process_message_form" model="ir.ui.view">
        <field name="name">view.mqtt.process.message.form</field>
        <field name="model">mqtt.process.message</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="payload"/>
                    <field name="history_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_process" class="oe_highlight" string="Process" type="object"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
           </form>
        </field>
    </record>

    <record id="action_mqtt_process_message" model="ir.actions.act_window">
        <field name="name">MQTT Process</field>
        <field name="res_model">mqtt.process.message</field>
        <field name="view_mode">form</field>
       <field name="target">new</field>
    </record>

</odoo>
