<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div class="o_action" t-name="stock_request_schedule.ScheduleSOReport" owl="1">
        <ControlPanel display="controlPanelDisplay">
            <t t-set-slot="control-panel-bottom-left-buttons">
                <div class="o_cp_buttons">
                    <div class="o_list_buttons"/>
                </div>
            </t>
            <t t-set-slot="control-panel-top-right">
                <form class="row gx-0">
                    <div class="col-lg-8 row">
                        <div class="col-lg-11 row gx-1 mb-2">


                        </div>
                    </div>
                </form>
            </t>

            <t t-set-slot="control-panel-bottom-right">
                <div class="o_search_options">

                </div>
            </t>
        </ControlPanel>
        <div class="o_content overflow-auto h-100">
            <div class="row">
                <div class="col-lg-12">
                    <div class="mt16" style="margin-left:10px;">
                        <h4>UnScheduled SO without Reserved Serial</h4>
                        <t t-if="state.unscheduleWithoutReserved[0]">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Sale Order</th>
                                        <th>Product</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.unscheduleWithoutReserved"
                                       t-key="unschedule_without_reserved[4]" t-as="unschedule_without_reserved">
                                        <tr>
                                            <td>
                                                <a href="#" t-att-data-res-id="unschedule_without_reserved[4]"
                                                   t-att-data-model="'sale.order'" t-on-click.prevent="goToAction">
                                                    <t t-esc="unschedule_without_reserved[0]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    [<t t-esc="unschedule_without_reserved[1]"/>]
                                                    <t t-esc="unschedule_without_reserved[2]"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h6>None</h6>
                        </t>
                        <br/>
                        <br/>
                        <h4>Scheduled SO with Reserved Serial</h4>
                        <t t-if="state.scheduleSOWithReserved[0]">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Sale Order</th>
                                        <th>Product</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.scheduleSOWithReserved" t-key="schedule_so_with_reserved[4]"
                                       t-as="schedule_so_with_reserved">
                                        <tr>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_reserved[4]"
                                                   t-att-data-model="'sale.order'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_reserved[0]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    [<t t-esc="schedule_so_with_reserved[1]"/>]
                                                    <t t-esc="schedule_so_with_reserved[2]"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h6>None</h6>
                        </t>
                        <br/>
                        <br/>
                        <h4>Scheduled SO with Different Product</h4>
                        <t t-if="state.scheduleSOWithDiff[0]">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Sale Order</th>
                                        <th>Product</th>
                                        <th>Stock Request</th>
                                        <th>Product</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.scheduleSOWithDiff" t-key="schedule_so_with_diff_product[0]"
                                       t-as="schedule_so_with_diff_product">
                                        <tr>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_diff_product[0]"
                                                   t-att-data-model="'sale.order'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_diff_product[1]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    [<t t-esc="schedule_so_with_diff_product[2]"/>]
                                                    <t t-esc="schedule_so_with_diff_product[3]"/>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_diff_product[4]"
                                                   t-att-data-model="'stock.request'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_diff_product[5]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    [<t t-esc="schedule_so_with_diff_product[6]"/>]
                                                    <t t-esc="schedule_so_with_diff_product[7]"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h6>None</h6>
                        </t>
                        <br/>
                        <br/>
                        <h4>Scheduled SO with Earlier Date</h4>
                        <t t-if="state.scheduleSOWithEarlyDate[0]">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Sale Order</th>
                                        <th>Stock Request</th>
                                        <th>SO Date - SR Date = Days Diff</th>
                                        <th>Product</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.scheduleSOWithEarlyDate" t-key="schedule_so_with_early_date[0]"
                                       t-as="schedule_so_with_early_date">
                                        <tr>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_early_date[0]"
                                                   t-att-data-model="'sale.order'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_early_date[1]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_early_date[5]"
                                                   t-att-data-model="'stock.request'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_early_date[6]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    <t t-esc="schedule_so_with_early_date[4]"/> -
                                                    <t t-esc="schedule_so_with_early_date[7]"/> =
                                                    <t t-esc="schedule_so_with_early_date[8]"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span>
                                                    [<t t-esc="schedule_so_with_early_date[2]"/>]
                                                    <t t-esc="schedule_so_with_early_date[3]"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h6>None</h6>
                        </t>
                        <br/>
                        <br/>
                        <h4>Scheduled SO with Later Date</h4>
                        <t t-if="state.scheduleSOWithLateDate[0]">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Sale Order</th>
                                        <th>Stock Request</th>
                                        <th>SO Date - SR Date = Days Diff</th>
                                        <th>Product</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.scheduleSOWithLateDate" t-key="schedule_so_with_late_date[0]"
                                       t-as="schedule_so_with_late_date">
                                        <tr>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_late_date[0]"
                                                   t-att-data-model="'sale.order'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_late_date[1]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_with_late_date[5]"
                                                   t-att-data-model="'stock.request'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_with_late_date[6]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    <t t-esc="schedule_so_with_late_date[4]"/> -
                                                    <t t-esc="schedule_so_with_late_date[7]"/> =
                                                    <t t-esc="schedule_so_with_late_date[8]"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span>
                                                    [<t t-esc="schedule_so_with_late_date[2]"/>]
                                                    <t t-esc="schedule_so_with_late_date[3]"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h6>None</h6>
                        </t>
                        <br/>
                        <br/>
                        <h4>Scheduled SO Not Confirmed</h4>
                        <t t-if="state.scheduleSONotConfirmed[0]">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Sale Order</th>
                                        <th>SO State</th>
                                        <th>Stock Request</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.scheduleSONotConfirmed" t-key="schedule_so_not_confirmed[0]"
                                       t-as="schedule_so_not_confirmed">
                                        <tr>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_not_confirmed[0]"
                                                   t-att-data-model="'sale.order'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_not_confirmed[1]"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span>
                                                    <t t-esc="schedule_so_not_confirmed[2]"/>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="#" t-att-data-res-id="schedule_so_not_confirmed[3]"
                                                   t-att-data-model="'stock.request'" t-on-click.prevent="goToAction">
                                                    <t t-esc="schedule_so_not_confirmed[4]"/>
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h6>None</h6>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </div>
</templates>