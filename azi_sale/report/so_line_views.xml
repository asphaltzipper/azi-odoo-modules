<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_so_line_report_tree" model="ir.ui.view">
        <field name="name">view.so.line.report.tree</field>
        <field name="model">so.line.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="order_name"/>
                <field name="order_line_name"/>
                <field name="confirm_date"/>
                <field name="customer_name"/>
                <field name="state"/>
                <field name="wc_code"/>
                <field name="route_name"/>
                <field name="salesperson"/>
            </tree>
        </field>
    </record>
    <record id="so_line_report_action" model="ir.actions.act_window">
        <field name="name">Open SO Lines</field>
        <field name="res_model">so.line.report</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="menu_so_line_report" parent="sale.menu_sale_report"
              action="so_line_report_action"/>

</odoo>
