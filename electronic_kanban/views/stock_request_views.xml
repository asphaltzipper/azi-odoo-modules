<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_request_tree" model="ir.ui.view">
        <field name="name">stock.request.tree</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request.view_stock_request_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="kanban_id"/>
            </field>
            <field name="product_id" position="after">
                <field name="product_responsible_id"/>
                <field name="product_deprecated"/>
                <field name="other_purchase_ids" widget="many2many_tags"/>
                <field name="has_other_pos" invisible="1"/>
                <field name="other_production_ids" widget="many2many_tags"/>
                <field name="has_other_mos" invisible="1"/>
            </field>
            <field name="product_uom_id" position="attributes">
                <attribute name="string">UOM</attribute>
            </field>
        </field>
    </record>

    <record id="stock_request_search" model="ir.ui.view">
        <field name="name">stock.request.search</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request.stock_request_search"/>
        <field name="arch" type="xml">
            <filter name="current_requests" position="after">
                <separator />
                <filter string="Obsolete" name="deprecated" domain="[('product_deprecated','=',True)]"/>
                <filter string="Current" name="non_deprecated" domain="[('product_deprecated','=',False)]"/>
            </filter>
            <filter name="open" position="after">
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]" />
            </filter>
            <filter name="location" position="after">
                <filter name="responsible" string="Manager" domain="[]" context="{'group_by':'product_responsible_id'}"/>
            </filter>
        </field>
    </record>

    <record id="stock_request.action_stock_request_form" model="ir.actions.act_window">
        <!--<field name="context" eval="context.update({'default_search_current_requests': 0, 'default_search_submit': 1})"/>-->
        <field name="context">{
            'search_default_current_requests': 0,
            'pivot_column_groupby': ['location_id'], 'pivot_row_groupby': ['product_id'], 'pivot_measures': ['product_uom_qty', 'qty_done'],
            'search_default_draft': 1, 'search_default_open': 1,
            'search_default_submitted': 1
        }</field>
    </record>

    <record id="view_stock_request_form" model="ir.ui.view">
        <field name="name">stock.request.form</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request.view_stock_request_form"/>
        <field name="arch" type="xml">
            <button name="action_done" position="before">
                <button name="check_done"
                    string="Check Done" type="object"
                    attrs="{'invisible': [('state', 'not in', ['open'])]}"/>
            </button>
            <field name="product_id" position="after">
                <field name="product_deprecated"/>
                <field name="product_responsible_id"/>
            </field>
        </field>
    </record>

</odoo>
