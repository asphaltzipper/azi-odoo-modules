<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_request_order_e_kanban_form" model="ir.ui.view">
        <field name="name">stock.request.order.form</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_form"/>
        <field name="arch" type="xml">
            <button name="action_confirm" position="after">
                <button name="action_check_done"
                    string="Check Done" type="object"
                    attrs="{'invisible': [('state', 'not in', ['open'])]}"/>
            </button>
            <xpath expr="//tree/field[@name='product_id']" position="after">
                <field name="product_active"/>
                <field name="product_deprecated"/>
                <field name="product_responsible_id"/>
            </xpath>
            <xpath expr="//field[@name='stock_request_ids']/tree/field[@name='name']" position="before">
                <field name="kanban_id"/>
            </xpath>
            <field name="product_uom_id" position="attributes">
                <attribute name="string">UOM</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_request_order_search">
        <field name="name">stock.request.order.search</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_search"/>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
            </filter>
        </field>
    </record>

    <record id="stock_request.stock_request_order_action" model="ir.actions.act_window">
        <field name="context">{
            'search_default_draft': 1,
            'search_default_submitted': 1,
            'search_default_open': 1
        }</field>
    </record>

</odoo>
