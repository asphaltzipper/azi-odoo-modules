<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_weight_record_accy_tree" model="ir.ui.view">
        <field name="name">product.weight.record.accy.tree</field>
        <field name="model">product.weight.record.accy</field>
        <field name="arch" type="xml">
            <tree string="Weighing Accessories" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_product_weight_record_accy" model="ir.actions.act_window">
        <field name="name">Weight Accessories</field>
        <field name="res_model">product.weight.record.accy</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_product_weight_accy"
        parent="stock.menu_product_in_config_stock"
        name="Weighing Accessories"
        sequence="60"
        action="action_product_weight_record_accy"
    />
</odoo>
