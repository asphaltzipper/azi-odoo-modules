<odoo>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="action_view_mrp_bom_history" type="object" icon="fa-wrench"
                        attrs="{'invisible': [('bom_history_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="bom_history_count"/></span>
                        <span class="o_stat_text">BOM History</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>