<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_history_form" model="ir.ui.view">
        <field name="name">view.mrp.bom.history.line.form</field>
        <field name="model">mrp.bom.history.line</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="bom_type"/>
                            <field name="bom_id"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="parent_product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mrp_bom_history_tree" model="ir.ui.view">
        <field name="name">view.mrp.bom.history.line.tree</field>
        <field name="model">mrp.bom.history.line</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="product_id"/>
                <field name="parent_product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="bom_id"/>
                <field name="bom_type"/>
            </tree>
        </field>
    </record>
    <record id="mrp_bom_history_action" model="ir.actions.act_window">
        <field name="name">BOM History</field>
        <field name="res_model">mrp.bom.history.line</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="mrp_bom_history_menu" action="mrp_bom_history_action" parent="mrp.menu_mrp_reporting"/>
</odoo>
