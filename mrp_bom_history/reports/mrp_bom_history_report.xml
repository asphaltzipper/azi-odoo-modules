<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bom_history">
        <t t-set="full_width" t-value="True"/>
        <t t-call="web.basic_layout">
            <t t-set="body_classname" t-value="''"/>
            <div class="page">
                    <div class="row">
                        <div class="col-lg-12">
                            <h1>BOM History</h1>
                        </div>
                        <div class="col-lg-12">
                            <div class="mt16">
                                <table class="table table-bordered" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th width="10%">Quantity</th>
                                            <th width="10%">Unit of Measure</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="docs.get('lines')" t-as="line">
                                            <tr>
                                                <td>
                                                    <t t-set="space_td"
                                                       t-value="'margin-left: '+ str(line['level'] * 20) + 'px;'"/>
                                                    <span t-att-style="space_td"/>
                                                    <t t-set="product_url"
                                                       t-value="env['ir.config_parameter'].sudo().get_param('web.base.url')+'/web#model=product.product&amp;id={}&amp;view_type=form'.format(line['product_id'][0])"/>
                                                    <a target='_blank' t-att-href="product_url" t-att-title="line['parent_product_id']">
                                                        <span t-esc="line['product_id'][1]"/>
                                                    </a>
                                                </td>
                                                <td>
                                                    <t t-esc="line['product_qty']"/>
                                                </td>
                                                <td>
                                                    <t t-esc="line['product_uom_id'][1]"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            </div>
        </t>
    </template>

</odoo>
