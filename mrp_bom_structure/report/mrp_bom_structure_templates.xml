<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_structure_down" model="ir.actions.report">
        <field name="name">BOM Structure Down</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mrp_bom_structure.bom_structure_down</field>
        <field name="report_file">mrp_bom_structure.bom_structure_down</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
    </record>

    <template id="bom_structure_down">
        <t t-call="web.basic_layout">
            <div class="page">
                <h2>BOM Structure</h2>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th width="10%">Quantity</th>
                            <th width="10%">Unit of Measure</th>

                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs.get('lines')" t-as="line">
                            <tr>
                                <td>
                                    <t t-set="space_td" t-value="'margin-left: '+ str(line['level'] * 20) + 'px;'"/>
                                    <span t-att-style="space_td"/>
                                    <t t-set="product_url" t-value="env['ir.config_parameter'].sudo().get_param('web.base.url')+'/web#model=product.product&amp;id={}&amp;view_type=form'.format(line['product_id'])"/>
                                    <t t-set="name_path" t-value="line['name_path']"/>
                                    <a target='_blank' t-att-href="product_url" t-att-title="name_path">
                                        <span t-esc="line['display_name']"/>
                                    </a>
                                </td>
                                <td><t t-esc="line['qty']"/></td>
                                <td>
                                    <t t-esc="line['uom_name']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>
