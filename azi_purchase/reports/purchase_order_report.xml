<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.date_planned" class="col-2 bm-2">
                <strong >Date Req.:</strong>
                <p t-field="o.date_planned" class="m-0" t-options="{'format': 'yyyy-MM-dd'}"/>
            </div>
        </xpath>
        <xpath expr="//table/thead/tr/th[@name='th_description']" position="before">
            <td name="th_sequence">SNO.</td>
        </xpath>
        <xpath expr="//table/thead/tr/th[@name='th_date_req']" position="replace"/>
        <xpath expr="//t[@t-foreach='o.order_line']/tr/t[1]" position="before">
            <td><span t-esc="line_index + 1"/></td>
        </xpath>
        <xpath expr="//t[@t-foreach='o.order_line']/tr/t[1]/td[4]" position="replace"/>
    </template>
</odoo>