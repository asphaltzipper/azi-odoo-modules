<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- add act mrp wo produce wizard button -->
    <record id="view_production_wo_produce_form" model="ir.ui.view">
        <field name="name">mrp.production.azi.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <button name="button_plan" position="after">
                <button name="%(mrp_wo_produce.view_mrp_component_serial_action)d" string="Assign Serial/Lot"
                        type="action" class="oe_highlight"
                        attrs="{'invisible': [ ('state', 'not in', ('confirmed', 'progress', 'to_close'))]}"/>
            </button>
            <page name="operations" position="after">
                <page name="labor" string="Labor Details">
                    <button
                        type="object"
                        name="reset_labor_ids"
                        string="Reset Labor"
                        confirm="Do you want to DELETE labor entries and reset to the default?"
                        attrs="{'invisible': [('state', 'in', ['done','cancel'])]}"
                    />
                    <field
                        name="labor_ids"
                        context="{'default_production_id': active_id}"
                        attrs="{'readonly': [('state', 'in', ['done','cancel'])]}"
                    >
                        <tree create="1" edit="1" editable="bottom">
                            <field name="production_id" invisible="1"/>
                            <field name="workorder_id" domain="[('production_id', '=', production_id)]"/>
                            <field name="employee_id" domain="[('user_id', '!=', False)]"/>
                            <field name="user_id"/>
                            <field name="hours_expected"/>
                            <field name="labor_date"/>
                            <field name="labor_time"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="attributes">
                <attribute name="invisible">context.get('active_model')=='mrp.production'</attribute>
            </field>
            <field name="lot_name" position="attributes">
                <attribute name="invisible">context.get('active_model')!='mrp.production'</attribute>
            </field>
        </field>
    </record>
</odoo>
