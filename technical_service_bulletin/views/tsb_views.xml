<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tsb_bulletin_form" model="ir.ui.view">
        <field name="name">tsb.bulletin.form</field>
        <field name="model">tsb.bulletin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="done_date"/>
                            <field name="is_done"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="desc" string="Description">
                            <field name="description"/>
                        </page>
                        <page name="serials" string="Serials">
                            <field name="serial_ids" context="{'default_bulletin_id': active_id}">
                                <tree>
                                    <field name="lot_id"/>
                                    <field name="done_date"/>
                                    <field name="partner_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tsb_bulletin_tree" model="ir.ui.view">
        <field name="name">tsb.bulletin.tree</field>
        <field name="model">tsb.bulletin</field>
        <field name="arch" type="xml">
            <tree string="Technical Service Bulletins">
                <field name="name"/>
                <field name="start_date"/>
                <field name="done_date"/>
            </tree>
        </field>
    </record>

    <record id="action_tsb_bulletin_tree" model="ir.actions.act_window">
        <field name="name">Technical Service Bulletins</field>
        <field name="res_model">tsb.bulletin</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_tsb_serial_tree" model="ir.ui.view">
        <field name="name">tsb.serial.tree</field>
        <field name="model">tsb.serial</field>
        <field name="arch" type="xml">
            <tree string="TSB Serials">
                <field name="name"/>
                <field name="start_date"/>
                <field name="done_date"/>
                <field name="partner_id"/>
            </tree>
        </field>
    </record>

    <record id="view_tsb_serial_search" model="ir.ui.view">
        <field name="name">tsb.serial.search</field>
        <field name="model">tsb.serial</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="bulletin_id" string="Bulletin"/>
                <field name="partner_id" string="Customer"/>
                <separator/>
                <filter string='Done' name="done" domain="[('is_done', '=', True)]" />
                <filter string='Waiting' name="waiting" domain="[('is_done', '=', False)]" />
                <group expand='0' string='Group by...'>
                    <filter string='Customer' name="group_customer" domain="[]" context="{'group_by' : 'partner_id'}"/>
                    <filter string='Bulletin' name="group_bulletin" domain="[]" context="{'group_by' : 'bulletin_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tsb_serial_tree" model="ir.actions.act_window">
        <field name="name">TSB Serials</field>
        <field name="res_model">tsb.serial</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_technical_service_bulletin"
              name="Technical Service Bulletin"
              parent="stock.menu_stock_inventory_control"
              action="action_tsb_bulletin_tree"
              sequence="1002"/>

    <menuitem id="menu_tsb_serial"
              name="TSB Serials"
              parent="stock.menu_stock_inventory_control"
              action="action_tsb_serial_tree"
              sequence="1003"/>

</odoo>
